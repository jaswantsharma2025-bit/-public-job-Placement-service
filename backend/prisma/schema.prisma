generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ─────────────────────────────────────────────────────────────────────

enum Role {
  CUSTOMER
  WORKER
  ADMIN
  EMPLOYER
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
}

enum EducationLevel {
  NO_FORMAL_EDUCATION
  PRIMARY
  SECONDARY
  HIGHER_SECONDARY
  DIPLOMA
  GRADUATE
  POST_GRADUATE
}

enum BookingType {
  INSTANT
  SCHEDULED
}

enum BookingStatus {
  PENDING
  ACCEPTED
  REJECTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PaymentStatus {
  PENDING
  PAID
}

enum ComplaintStatus {
  OPEN
  RESOLVED
  REJECTED
}

// ── Skill Taxonomy ────────────────────────────────────────────────────────────

model Category {
  id   String @id @default(cuid())
  name String @unique   // e.g. "Healthcare", "Domestic"
  slug String @unique   // e.g. "healthcare", "domestic"

  subCategories SubCategory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model SubCategory {
  id         String @id @default(cuid())
  name       String            // e.g. "Nurse", "Cook"
  slug       String @unique    // e.g. "nurse", "cook"
  categoryId String

  category     Category      @relation(fields: [categoryId], references: [id])
  workerSkills WorkerSkill[]
  bookings     Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([categoryId])
}

// Join table: Worker ↔ SubCategory (many-to-many)
model WorkerSkill {
  id            String @id @default(cuid())
  workerProfileId String
  subCategoryId   String

  workerProfile WorkerProfile @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)
  subCategory   SubCategory   @relation(fields: [subCategoryId], references: [id])

  createdAt DateTime @default(now())

  @@unique([workerProfileId, subCategoryId])
  @@index([workerProfileId])
  @@index([subCategoryId])
}

// ── Users ─────────────────────────────────────────────────────────────────────

model User {
  id       String @id @default(cuid())
  name     String
  phone    String @unique
  password String
  role     Role
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  customerProfile CustomerProfile?
  workerProfile   WorkerProfile?
  employerProfile EmployerProfile?

  customerBookings Booking[] @relation("CustomerBookings")
  workerBookings   Booking[] @relation("WorkerBookings")
  customerReviews  Review[]  @relation("CustomerReviews")
  workerReviews    Review[]  @relation("WorkerReviews")
}

model CustomerProfile {
  id     String @id @default(cuid())
  userId String @unique

  gender    Gender?
  address   String?
  city      String?
  state     String?
  latitude  Float?
  longitude Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model WorkerProfile {
  id     String @id @default(cuid())
  userId String @unique

  // ── Documents ────────────────────────────────────────────
  aadhaarNumber   String  @unique
  profilePhotoUrl String?

  // ── Personal ─────────────────────────────────────────────
  gender         Gender?
  dateOfBirth    DateTime?
  height         Float?
  weight         Float?
  languagesKnown String[]
  education      EducationLevel?
  maritalStatus  MaritalStatus?

  // ── Professional ─────────────────────────────────────────
  experience              Int
  expectedSalary          Float
  aboutYourself           String?
  previousCompanies       String?
  certifications          String?
  availableTimings        String?
  preferredWorkingRadius  Int?
  canRelocate             Boolean @default(false)

  // ── Family & Emergency ───────────────────────────────────
  fatherName             String?
  motherName             String?
  emergencyContact       String?
  emergencyContactNumber String?

  // ── Location ─────────────────────────────────────────────
  city      String?
  state     String?
  latitude  Float?
  longitude Float?

  // ── Platform ─────────────────────────────────────────────
  isVerified  Boolean @default(false)
  isAvailable Boolean @default(true)
  isSuspended Boolean @default(false)

  rating       Float @default(0)
  totalReviews Int   @default(0)

  verifiedAt       DateTime?
  verifiedBy       String?
  suspensionReason String?
  rejectionReason  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  user   User          @relation(fields: [userId], references: [id])
  skills WorkerSkill[]
}

model EmployerProfile {
  id     String @id @default(cuid())
  userId String @unique

  companyName   String
  contactPerson String
  address       String?
  city          String?
  state         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id])
}

// ── Bookings ──────────────────────────────────────────────────────────────────

model Booking {
  id String @id @default(cuid())

  customerId String
  workerId   String

  customerName  String
  customerPhone String
  workerName    String
  workerPhone   String

  bookingType BookingType

  // Skill the customer booked for
  subCategoryId String
  subCategory   SubCategory @relation(fields: [subCategoryId], references: [id])

  address         String
  city            String
  scheduledDate   DateTime
  durationMinutes Int
  servicePrice    Float?
  notes           String?

  status      BookingStatus @default(PENDING)
  acceptedAt  DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  cancelledAt DateTime?

  workerPayout   Float? @default(0)
  platformFee    Float? @default(0)
  isPaidToWorker Boolean @default(false)
  paidAt         DateTime?

  paymentStatus PaymentStatus @default(PENDING)
  paymentMethod String?

  startedByCustomer   Boolean @default(false)
  completedByCustomer Boolean @default(false)

  replacementRequested  Boolean @default(false)
  replacementReason     String?
  replacementWorkerId   String?
  replacementAssignedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  customer   User        @relation("CustomerBookings", fields: [customerId], references: [id])
  worker     User        @relation("WorkerBookings", fields: [workerId], references: [id])
  review     Review?
  complaints Complaint[]

  @@index([customerId])
  @@index([workerId])
  @@index([status])
  @@index([subCategoryId])
}

model Review {
  id         String @id @default(cuid())
  bookingId  String @unique
  customerId String
  workerId   String

  rating  Int
  comment String?

  createdAt DateTime @default(now())

  booking  Booking @relation(fields: [bookingId], references: [id])
  customer User    @relation("CustomerReviews", fields: [customerId], references: [id])
  worker   User    @relation("WorkerReviews", fields: [workerId], references: [id])

  @@index([workerId])
}

model Complaint {
  id             String @id @default(cuid())
  bookingId      String
  raisedByUserId String
  againstUserId  String

  reason      String
  description String?

  status     ComplaintStatus @default(OPEN)
  adminNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id])

  @@index([bookingId])
  @@index([raisedByUserId])
  @@index([againstUserId])
}
